DRA2API_CONTAINER_NAME=dra2api
DRA2API_PORT=8798
TZ=Asia/Taipei

DRA_API_KEY=sk-replace-with-api-key
DRA_ADMIN_TOKEN=replace-with-admin-token
DRA_SYNC_TOKEN=replace-with-account-sync-token
DRA_DATA_DIR=/app/data
DRA_DATABASE_PATH=/app/data/dra2api.db

DRA_TASK_WORKERS=10
DRA_TASK_QUEUE_CAPACITY=100
DRA_POLL_INTERVAL_SECONDS=10
DRA_TASK_TIMEOUT_SECONDS=1800
DRA_SYNCHRONOUS_TIMEOUT_SECONDS=900
DRA_REQUEST_TIMEOUT_SECONDS=90
DRA_REQUEST_RETRIES=2
DRA_ACCOUNT_MAINTENANCE_INTERVAL_SECONDS=300
DRA_ACCOUNT_MAINTENANCE_WORKERS=3
DRA_DAILY_CHECKIN_ENABLED=true
DRA_ACCOUNT_DEFAULT_CONCURRENCY=1

DRA_MEDIA_TIMEOUT_SECONDS=180
DRA_MEDIA_MAX_BYTES=104857600
DRA_MEDIA_FALLBACK_PROXY_URL=http://127.0.0.1:10809

DRA_BROWSER_RECOVERY_ENABLED=true
DRA_BROWSER_TIMEOUT_SECONDS=180
DRA_BROWSER_LOGIN_WORKERS=2
DRA_BROWSER_LOGIN_STAGGER_SECONDS=3
DRA_BROWSER_CHALLENGE_GRACE_SECONDS=12
DRA_CHROME_EXECUTABLE=
DRA_CHROME_USER_DATA_ROOT=data/dra-chrome-profiles
DRA_CHROME_CDP_BASE_PORT=20800
DRA_CHROME_HEADLESS=false

DRA_PROXY_HOST_OVERRIDE=
DRA_PROXY_POOL_ENABLED=true
# Comma-separated. Docker peers can use xray:20001 directly.
DRA_PROXY_POOL=

DRA_LOW_BALANCE_DISABLE_THRESHOLD=1
DRA_EXCESS_MEDIA_POLICY=strict
DRA_ALLOW_VIDEO_REFERENCE_INPUTS=true
DRA_PROMPT_MEDIA_REFERENCE_CLEANUP_ENABLED=false
DRA_MODEL_MAP={"seedance-2.0-mini":"doubao-seedance-2-0-mini-260615","seedance-2.0-fast":"doubao-seedance-2-0-fast-260128","seedance-2.0":"doubao-seedance-2-0-260128","seedance-2.5":"doubao-seedance-2-5"}
DRA_SCHEMA_VERSION=1.0.0
